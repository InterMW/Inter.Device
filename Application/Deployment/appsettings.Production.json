{
    "AllowedHosts": "*",
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Kestrel": {
        "Endpoints": {
            "WebApi": {
                "Url": "http://0.0.0.0:8080",
                "Protocols": "Http1"
            },
            "gRPC": {
                "Url": "http://0.0.0.0:6000",
                "Protocols": "Http2"
            }
        }
    },
    "MongoDB": {
        "PublicDeviceRepo": "mongodb://notmongo:RMg19GEaUvdZ@10.0.0.3:27017"
    },
    "ConnectionStrings": {
      "AuthorizerGrpc" : "http://interauthorizer:6000"
    },
    "IpKey": {
        "Key": "#{IPAPIKEY}"
    },
    "Mqtt":
    {
      "User": "#{MQTT_USER}",
      "Password": "#{MQTT_PASS}",
      "Host": "mosquitto"
    },
    "Rabbit": {
        "ClientDeclarations": {
            "Connections": [
                {
                    "Name": "Connection",
                    "ClientName": "DeviceDomain",
                    "ServerName": "rabbitplugs",
                    "UserName": "#{RABBIT_USER}",
                    "Password": "#{RABBIT_PASSWORD}"
                }
            ],
            "Publishers": [
                {
                    "Name": "PlaneFrameMessage",
                    "Connection": "Connection",
                    "Exchange": "amq.topic"
                },
                {
                    "Name": "MetricMessage",
                    "Connection": "Connection",
                    "Exchange": "amq.topic"
                }
            ]
        },
        "ServerDeclarations": {
            "Exchanges": [
                {
                    "Name": "InterTopic",
                    "Type": "Topic",
                    "AutoDelete": "False",
                    "Durable": "True",
                    "Connection": "Connection"
                }
            ]
        }
    }
}
